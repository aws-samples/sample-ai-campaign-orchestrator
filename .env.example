# Environment Configuration
ENVIRONMENT=development
VARIANT=aws
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_RELOAD=true
SECRET_KEY=your-secret-key-here-change-in-production

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_CREDENTIALS=true

# Feature Flags
ENABLE_PROPERTY_TESTS=true
ENABLE_ANALYTICS=true
ENABLE_GUARDRAILS=true
ENABLE_FATIGUE_PROTECTION=true

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB Tables
DYNAMODB_CUSTOMER_TABLE=ai-cpaas-customers
DYNAMODB_DECISIONS_TABLE=ai-cpaas-decisions
DYNAMODB_FREQUENCY_TABLE=ai-cpaas-frequency

# S3 Buckets
S3_CONTENT_BUCKET=ai-cpaas-content
S3_MODELS_BUCKET=ai-cpaas-models

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-west-2

# SageMaker
SAGEMAKER_ENDPOINT_NAME=ai-cpaas-prediction

# CPaaS Services
END_USER_MESSAGING_CONFIG_SET=ai-cpaas-config
SES_CONFIG_SET=ai-cpaas-ses
CONNECT_INSTANCE_ID=your-connect-instance-id

# Open Source Configuration (for Variant B)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_cpaas
POSTGRES_USER=ai_cpaas
POSTGRES_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

OPENAI_API_KEY=your-openai-api-key
LANGCHAIN_API_KEY=your-langchain-api-key

KAFKA_BOOTSTRAP_SERVERS=["localhost:9092"]
KAFKA_TOPIC_PREFIX=ai-cpaas

# Demo Configuration
DEMO_CUSTOMER_COUNT=1000
DEMO_SCENARIOS_ENABLED=true
PRESENTATION_MODE=false

# Cost Configuration (per message/minute)
SMS_COST_PER_MESSAGE=0.0075
WHATSAPP_COST_PER_MESSAGE=0.005
EMAIL_COST_PER_MESSAGE=0.0001
VOICE_COST_PER_MINUTE=0.013
SPRAY_PRAY_MULTIPLIER=1.3